{
	"name": "@bilibili-notify/extension",
	"description": "Public contract and build helpers for bilibili-notify extensions",
	"private": true,
	"version": "0.1.0-alpha.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Akokk0/bilibili-notify"
	},
	"author": {
		"name": "Akokko",
		"email": "admin@akokko.com"
	},
	"type": "module",
	"files": [
		"lib"
	],
	"license": "MIT",
	"publishConfig": {
		"directory": "lib",
		"access": "public"
	},
	"types": "./lib/index.d.mts",
	"exports": {
		".": "./lib/index.mjs",
		"./build": "./lib/build.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack && node scripts/prepare-package.mjs",
		"dev": "vp pack --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@bilibili-notify/internal": "workspace:*",
		"zod": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
