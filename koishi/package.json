{
	"name": "koishi-plugin-bilibili-notify",
	"description": "Bilibili 动态推送、直播通知 Koishi 插件",
	"version": "5.1.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/Akokk0/bilibili-notify"
	},
	"author": {
		"name": "Akokko",
		"email": "admin@akokko.com"
	},
	"type": "module",
	"main": "./lib/index.cjs",
	"types": "./lib/index.d.cts",
	"files": [
		"lib",
		"dist"
	],
	"exports": {
		".": "./lib/index.cjs",
		"./package.json": "./package.json"
	},
	"license": "MIT",
	"keywords": [
		"chatbot",
		"koishi",
		"plugin",
		"bilibili",
		"bilibili-notify"
	],
	"scripts": {
		"build": "vp pack && node ../scripts/copy-jieba-wasm.mjs",
		"build:client": "yakumo build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"jsdom": "^30.0.1"
	},
	"devDependencies": {
		"@bilibili-notify/ai": "workspace:^",
		"@bilibili-notify/api": "workspace:^",
		"@bilibili-notify/dynamic": "workspace:^",
		"@bilibili-notify/image": "workspace:^",
		"@bilibili-notify/internal": "workspace:^",
		"@bilibili-notify/live": "workspace:^",
		"@bilibili-notify/push": "workspace:^",
		"@bilibili-notify/storage": "workspace:^",
		"@bilibili-notify/subscription": "workspace:^",
		"@koishijs/client": "^5.30.11",
		"@koishijs/plugin-console": "^5.30.11",
		"@koishijs/plugin-help": "^2.4.6",
		"@koishijs/plugin-notifier": "^1.2.1",
		"koishi-plugin-puppeteer": "^3.9.0",
		"yakumo": "^1.0.0"
	},
	"peerDependencies": {
		"@koishijs/plugin-console": "^5.30.11",
		"@koishijs/plugin-notifier": "*",
		"koishi": "^4.18.11",
		"koishi-plugin-puppeteer": "*"
	},
	"peerDependenciesMeta": {
		"koishi-plugin-puppeteer": {
			"optional": true
		}
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"koishi": {
		"service": {
			"required": [
				"console",
				"notifier"
			],
			"optional": [
				"puppeteer"
			]
		},
		"description": {
			"zh": "Bilibili 动态推送、直播通知插件"
		}
	},
	"inlinedDependencies": {
		"@jridgewell/sourcemap-codec": "1.5.5",
		"@koishijs/plugin-help": "2.4.6",
		"@unocss/core": "66.8.1",
		"@unocss/extractor-arbitrary-variants": "66.8.1",
		"@unocss/preset-wind4": "66.8.1",
		"@unocss/rule-utils": "66.8.1",
		"@vue/reactivity": [
			"3.5.34",
			"3.5.42"
		],
		"@vue/runtime-core": [
			"3.5.34",
			"3.5.42"
		],
		"@vue/runtime-dom": [
			"3.5.34",
			"3.5.42"
		],
		"@vue/server-renderer": "3.5.42",
		"@vue/shared": [
			"3.5.34",
			"3.5.42"
		],
		"abort-controller": "3.0.0",
		"agentkeepalive": "4.6.0",
		"charenc": "0.0.2",
		"cron": "4.4.0",
		"crypt": "0.0.2",
		"csstype": "3.2.3",
		"dijkstrajs": "1.0.3",
		"event-target-shim": "5.0.1",
		"form-data-encoder": "1.7.2",
		"formdata-node": "4.4.1",
		"humanize-ms": "1.2.1",
		"is-buffer": "1.1.6",
		"jieba-wasm": "2.4.0",
		"long": "5.3.2",
		"luxon": "3.7.2",
		"magic-string": "1.2.1",
		"md5": "2.3.0",
		"ms": "2.1.3",
		"node-domexception": "1.0.0",
		"node-fetch": "2.7.0",
		"openai": "4.104.0",
		"pngjs": "5.0.0",
		"protobufjs": "8.8.0",
		"qrcode": "1.5.4",
		"tr46": "0.0.3",
		"vue": [
			"3.5.34",
			"3.5.42"
		],
		"web-streams-polyfill": "4.0.0-beta.3",
