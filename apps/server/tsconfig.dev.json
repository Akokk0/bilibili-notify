{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"rootDir": null,
		"jsx": "react-jsx",
		"jsxImportSource": "vue",
		"paths": {
			"@bilibili-notify/contract": ["../contract/src/index.ts"],
			"@bilibili-notify/internal/*": ["../../packages/internal/src/*"],
			"@bilibili-notify/*": ["../../packages/*/src/index.ts"]
		}
	},
	"include": ["src", "../../packages/*/src", "../contract/src"]
}
