{
	"name": "@bilibili-notify/desktop",
	"version": "0.0.0-dev",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare-rust-check": "node -e \"require('node:fs').mkdirSync('src-tauri/resources',{recursive:true})\"",
		"prepare-resources": "node scripts/prepare-resources.mjs",
		"cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
		"cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
		"cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
		"cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
		"check:rust": "vp run prepare-rust-check && vp run cargo:fmt && vp run cargo:clippy && vp run cargo:test && vp run cargo:check",
		"front:dev": "vp dev",
		"front:build": "vp build",
		"typecheck": "tsc --noEmit",
		"dev": "node scripts/prepare-resources.mjs && vpx tauri dev",
		"tauri:build": "node scripts/prepare-resources.mjs && node scripts/tauri-build.mjs"
	},
	"dependencies": {
		"@bilibili-notify/ui": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"jsdom": "catalog:",
		"tailwindcss": "catalog:",
		"vite": "*"
	}
}
