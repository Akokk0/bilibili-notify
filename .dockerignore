# Build outputs — rebuilt inside the image.
**/lib
**/dist

# All node_modules — populated by yarn/pnpm in the builder stage.
**/node_modules

# Local pnpm store.
.pnpm-store

# Repo metadata + editor noise.
.git
.github
.gitignore
.gitattributes
.idea
.vscode
.DS_Store
*.swp

# Markdown / design assets / logs not needed at build time.
# 例外:被 web 端 `?raw` 静态导入的 md 是构建产物的一部分,漏进上下文 = Vite 解析
# 失败,而且只在打镜像时炸(CI 的 build/typecheck 不走 Docker,拦不住)。
**/*.md
!apps/CHANGELOG.md
!apps/web/src/pages/guide/content/*.md
.bn-design

# Local-only state and secrets from previous runs.
.env
.env.*
**/.env
**/.env.*
**/master.key
**/*.pem
**/*.key
**/*.enc
data/**
logs/**
apps/server/data
apps/server/data/**
apps/server/bn-data
apps/server/bn-data/**
apps/server/logs
apps/server/logs/**
apps/server/bn.config.yaml
apps/server/bn.config.yml
apps/server/bn.config.json

# Test snapshots / build cache.
**/tsconfig.tsbuildinfo
**/.eslintcache
**/coverage

# Lefthook output.
.lefthook
